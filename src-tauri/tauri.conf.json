{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniStudio",
  "version": "0.1.0",
  "identifier": "studio.ministudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiniStudio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#11171d",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
