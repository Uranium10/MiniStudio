{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MiniStudio desktop file and dialog permissions",
  "windows": ["main", "plugin-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
